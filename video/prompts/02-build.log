    lines.push(
      \`  tl.fromTo("\${sel}", { opacity: 0 }, { opacity: 1, duration: \${fadeIn}, ease: "none" }, \${n(t0)});\`,
    );
    lines.push(
      \`  tl.to("\${sel}", { opacity: 0, duration: \${fadeOut}, ease: "none" }, \${n(outAt)});\`,
    );`;
const newJs = `    const outAt = Math.max(t0 + fadeIn + 0.02, t1 - fadeOut);
    lines.push(\`  tl.set("\${sel}", { opacity: 0 }, 0);\`);
    lines.push(
      \`  tl.fromTo("\${sel}", { opacity: 0 }, { opacity: 1, duration: \${fadeIn}, ease: "none" }, \${n(t0)});\`,
    );
    lines.push(
      \`  tl.to("\${sel}", { opacity: 0, duration: \${fadeOut}, ease: "none" }, \${n(outAt)});\`);`;
if(!s.includes(oldJs)) throw new Error('cap js not found');
s = s.replace(oldJs, newJs);

fs.writeFileSync('tools/build.mjs',s);
