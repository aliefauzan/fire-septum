const oldMark = '`<span class="cap" id="c\${scene.id}-cap\${i + 1}">\${c[2]}</span>`';
const newMark = '`<span class="cap" id="c\${scene.id}-cap\${i + 1}"><span class="pill">\${c[2]}</span></span>`';
if(!s.includes(oldMark)) throw new Error('cap markup not found');
s = s.replace(oldMark, newMark);

