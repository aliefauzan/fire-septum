import re
sb=open('STORYBOARD.md').read()
frames=re.findall(r'## Frame (\d+) — (.+?)\n\n(.*?)(?=\n## |\Z)', sb, re.S)
sc=open('SCRIPT.md').read()
lines=re.findall(r'## Line (\d+) — .*?\*\*Time:\*\* (\S+) – (\S+).*?\n\n    (.*?)(?:\n\n|\Z)', sc, re.S)
def sec(t):
    m,s=t.split(':'); return int(m)*60+int(s)
line_by={n:(t0,t1,spoken) for n,t0,t1,spoken in lines}
tot=0; ok=True
for n,title,body in frames:
    st=float(re.search(r'- start: ([\d.]+)s',body).group(1))
    du=float(re.search(r'- duration: (\d+)s',body).group(1))
    vo=re.search(r'- voiceover: "(.*?)"\n',body,re.S).group(1)
    t0,t1,spoken=line_by[n]
    m1 = abs(sec(t0)-st)<0.51
    m2 = abs(sec(t1)-(st+du))<0.51
    m3 = vo.strip()==spoken.strip()
    m4 = spoken.strip() in body
    if not(m1 and m2 and m3 and m4): ok=False
    print(f"Frame {n:>2} {st:6.1f}+{du:4.1f} -> {st+du:6.1f} | time {'OK' if m1 and m2 else 'BAD'} | vo{'==' if m3 else '!='}script | quoted {'OK' if m4 else 'MISSING'}")
    tot+=du
print(f"\nTOTAL {tot:.0f}s = {int(tot)//60}:{int(tot)%60:02d}  (must be 210-255)   consistency: {'ALL OK' if ok else 'PROBLEMS'}")
# caption windows inside each frame
for n,title,body in frames:
    du=float(re.search(r'- duration: (\d+)s',body).group(1))
    wins=[float(x) for x in re.findall(r'^\s+- (\d+\.\d+)[–-](\d+\.\d+) s', body, re.M) for x in x]
    cap=re.findall(r'^\s+- (\d+\.\d+)–(\d+\.\d+) s',body,re.M)
    bad=[c for c in cap if float(c[0])<0 or float(c[1])>du+0.01]
    print(f"Frame {n:>2} caption windows {len(cap)}  out-of-range: {bad if bad else 'none'}")
