# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it the app still loads live weather, terrain and OSM land use; hotspots must be placed by hand.
FIRMS_MAP_KEY=

# Optional AI briefing (OpenAI-compatible chat completions endpoint). Only simulation
# numbers are sent; the model writes prose, it does not make predictions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Ed25519 key (PKCS#8 PEM, \n-escaped) that signs run receipts. If unset, the
# server generates one on first use and keeps it in .cache/receipt-ed25519.pem.
RECEIPT_ED25519_KEY=

# Optional: attest daily batch roots with EAS on Base (scripts/attest.mjs). Put the key in
# .env.local (gitignored), not here: `node scripts/new-testnet-wallet.mjs` makes one for Base Sepolia.
# Without a key, attest.mjs only prints and simulates (eth_call); it never broadcasts.
# EAS_PRIVATE_KEY=
# EAS_RPC_URL=https://sepolia.base.org
# EAS_BATCH_URI_BASE=https://raw.githubusercontent.com/aliefauzan/fire-septum/main/data/batches/
# SiPongi (Kementerian Kehutanan hotspot and peat water-table system). Its terms forbid access
# without written permission from the Ministry, so the adapter is off. Set to "granted" only if
# you hold that permission; then /api/sipongi/* answers and the map shows its labels and stations.
SIPONGI_PERMISSION=
